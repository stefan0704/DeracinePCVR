# Game dumps and packages (Never commit user game files)
games/*
!games/PUT YOUR GAME HERE.txt

# Emulator user data, logs and saves
pc-vr/user/log/
pc-vr/user/home/
pc-vr/user/cache/
pc-vr/user/crash_dumps/
pc-vr/user/download/
pc-vr/user/imgui.ini
pc-vr/user/play_time.txt
pc-vr/user/vr_headset_fov.json
*.log

# Build artifacts
build/
bin/
*.obj
*.exe.stackdump
_vr_backup/

# Ignore third-party submodule source trees (fetched via git submodules or CMake)
src/externals/*
!src/externals/CMakeLists.txt
!src/externals/cmake-modules/
!src/externals/openxr-sdk/
!src/externals/gcn/
!src/externals/renderdoc/
!src/externals/stb/
!src/externals/dr_flac/
!src/externals/aacdec/
src/externals/aacdec/*
!src/externals/aacdec/CMakeLists.txt

# Documentation and settings
DEVELOPMENT.md
settings.json